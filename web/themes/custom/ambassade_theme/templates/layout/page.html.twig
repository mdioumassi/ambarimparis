{#
/**
 * @file
 * Gabarit de page — Ambassade de Mauritanie en France.
 *
 * Régions déclarées dans ambassade_theme.info.yml : topbar, header,
 * primary_menu, breadcrumb, highlighted, hero, quick_access, news, content,
 * sidebar_first, contact_block, footer_top, footer_bottom, help.
 */
#}
<div class="layout-page">

  {% if page.topbar %}
    <div class="topbar">
      <div class="container topbar__inner">
        {{ page.topbar }}
      </div>
    </div>
  {% endif %}

  <header class="site-header" data-nav-header>
    <div class="container site-header__inner">
      <div class="site-header__branding">
        {{ page.header }}
      </div>
      <div class="site-header__utility">
        <button type="button" class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="primary-menu-panel">
          <svg class="nav-toggle__icon nav-toggle__icon--open" aria-hidden="true"><use href="#icon-menu"></use></svg>
          <svg class="nav-toggle__icon nav-toggle__icon--close" aria-hidden="true"><use href="#icon-close"></use></svg>
          <span class="visually-hidden">{{ 'Menu'|t }}</span>
        </button>
      </div>
      <div id="primary-menu-panel" data-nav-panel>
        {{ page.primary_menu }}
        <a href="/demarches" class="button button--primary site-header__cta">{{ 'Prendre RDV'|t }}</a>
      </div>
    </div>
  </header>

  {% if page.highlighted %}
    <div class="region-highlighted" role="region" aria-label="{{ 'Alertes'|t }}">
      {{ page.highlighted }}
    </div>
  {% endif %}

  {% if page.breadcrumb %}
    <div class="container">
      {{ page.breadcrumb }}
    </div>
  {% endif %}

  {% if page.hero %}
    <div class="region-hero hero">
      {{ page.hero }}
    </div>
  {% endif %}

  {{ page.help }}

  <main class="layout-page__main">
    <a id="main-content" tabindex="-1"></a>{# Cible du lien d'évitement (html.html.twig). #}

    <div class="container region-content">
      {% if page.sidebar_first %}
        <div class="layout-with-sidebar">
          <div class="layout-content">
            {{ page.content }}
          </div>
          <aside class="layout-sidebar-first">
            {{ page.sidebar_first }}
          </aside>
        </div>
      {% else %}
        <div class="layout-content">
          {{ page.content }}
        </div>
      {% endif %}
    </div>

  </main>

  {% if page.quick_access %}
    <div class="region-quick-access">
      <div class="container">
        {{ page.quick_access }}
      </div>
    </div>
  {% endif %}

  {% if page.news %}
    <div class="region-news">
      <div class="container">
        {{ page.news }}
      </div>
    </div>
  {% endif %}

  {% if page.contact_block %}
    <div class="region-contact-block">
      <div class="container">
        {{ page.contact_block }}
      </div>
    </div>
  {% endif %}

  <footer class="site-footer">
    <div class="site-footer__top">
      <div class="container footer-grid">
        {{ page.footer_top }}
      </div>
    </div>
    <div class="site-footer__bottom">
      <div class="container">
        {{ page.footer_bottom }}
      </div>
    </div>
  </footer>

</div>
