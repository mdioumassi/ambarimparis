{#
/**
 * @file
 * Fiche actualité (vue complète).
 */
#}
<article{{ attributes.addClass('node', 'node--type-actualite', 'article') }}>

  <div class="article__meta">
    {% if content.field_type_actualite|render %}
      <span class="article__type">{{ content.field_type_actualite }}</span>
    {% endif %}
    {% if content.field_date_publication|render %}
      <span class="article__date">{{ content.field_date_publication }}</span>
    {% endif %}
  </div>

  {% if content.field_chapo|render %}
    <div class="article__chapo">{{ content.field_chapo }}</div>
  {% endif %}

  {% if content.field_image|render %}
    <div class="article__media">
      {{ content.field_image }}
    </div>
  {% endif %}

  <div class="article__body">
    {{ content.body }}
  </div>

  <a class="article__back" href="{{ path('view.actualites.page_1') }}">{{ 'Toutes les actualités'|t }}</a>

  <script type="application/ld+json">
    {{ {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      'headline': node.label(),
      'datePublished': node.field_date_publication.value,
      'dateModified': node.getChangedTime()|date('c'),
      'mainEntityOfPage': canonical_url,
      'publisher': {
        '@type': 'GovernmentOrganization',
        'name': site_name,
      },
    }|json_encode|raw }}
  </script>

</article>
