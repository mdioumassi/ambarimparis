{#
/**
 * @file
 * Carte "démarche" (liste des démarches).
 */
#}
<article{{ attributes.addClass('card', 'card--demarche') }}>
  <div class="card__body">
    {% if content.field_service|render %}
      <span class="card__eyebrow">{{ content.field_service }}</span>
    {% endif %}
    <h3 class="card__title">
      <a href="{{ url }}">{{ label }}</a>
    </h3>
    {% if content.field_public_concerne|render %}
      <div class="card__excerpt">{{ content.field_public_concerne }}</div>
    {% endif %}
    <div class="card__footer">
      {% if content.field_delais|render %}
        <span class="card__delay">
          <svg class="button__icon" aria-hidden="true"><use href="#icon-calendar"></use></svg>
          {{ content.field_delais }}
        </span>
      {% endif %}
      <span class="card__more" aria-hidden="true">{{ 'Voir la démarche'|t }}</span>
    </div>
  </div>
</article>
