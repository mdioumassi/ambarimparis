{#
/**
 * @file
 * Fiche démarche (vue complète).
 */
#}
<article{{ attributes.addClass('node', 'node--type-demarche', 'procedure') }}>

  {% if content.field_service|render %}
    <div class="procedure__meta">
      <span class="procedure__service">{{ content.field_service }}</span>
    </div>
  {% endif %}

  {% if content.field_delais|render or content.field_tarifs|render %}
    <dl class="procedure__facts">
      {% if content.field_delais|render %}
        <div class="procedure__fact">
          <dt><svg class="button__icon" aria-hidden="true"><use href="#icon-calendar"></use></svg>{{ 'Délais'|t }}</dt>
          <dd>{{ content.field_delais }}</dd>
        </div>
      {% endif %}
      {% if content.field_tarifs|render %}
        <div class="procedure__fact">
          <dt>{{ 'Tarifs'|t }}</dt>
          <dd>{{ content.field_tarifs }}</dd>
        </div>
      {% endif %}
    </dl>
  {% endif %}

  {% if content.field_public_concerne|render %}
    <section class="procedure__section">
      <h2>{{ 'Public concerné'|t }}</h2>
      {{ content.field_public_concerne }}
    </section>
  {% endif %}

  {% if content.field_pieces_a_fournir|render %}
    <section class="procedure__section procedure__section--pieces">
      <h2>{{ 'Pièces à fournir'|t }}</h2>
      {{ content.field_pieces_a_fournir }}
    </section>
  {% endif %}

  {% if content.field_modalites|render %}
    <section class="procedure__section">
      <h2>{{ 'Modalités de dépôt et de retrait'|t }}</h2>
      {{ content.field_modalites }}
    </section>
  {% endif %}

  {% if content.field_formulaires|render %}
    <section class="procedure__section">
      <h2>{{ 'Formulaires'|t }}</h2>
      {{ content.field_formulaires }}
    </section>
  {% endif %}

  {% if content.field_faq|render %}
    <section class="procedure__section procedure__section--faq">
      <h2>{{ 'Questions fréquentes'|t }}</h2>
      {{ content.field_faq }}
    </section>
    {% set faq_entities = [] %}
    {% for item in node.field_faq %}
      {% set faq_entities = faq_entities|merge([{
        '@type': 'Question',
        'name': item.entity.field_question.value,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': item.entity.field_reponse.value|striptags|trim,
        },
      }]) %}
    {% endfor %}
    {% if faq_entities is not empty %}
      <script type="application/ld+json">
        {{ {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          'mainEntity': faq_entities,
        }|json_encode|raw }}
      </script>
    {% endif %}
  {% endif %}

  <a class="article__back" href="{{ path('view.demarches.page_1') }}">{{ 'Toutes les démarches'|t }}</a>

</article>
